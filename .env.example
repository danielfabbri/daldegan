# Chave gratuita: https://quantumnumbers.anu.edu.au (100 requisições/mês)
DALDEGAN_QRNG_API_KEY=
DALDEGAN_QRNG_ENDPOINT=https://api.quantumnumbers.anu.edu.au
DALDEGAN_QRNG_TIMEOUT_S=30
# uint8 (padrão) ou hex16 (só depois de confirmar o formato com chave real)
DALDEGAN_QRNG_DATA_TYPE=uint8
DALDEGAN_DATA_DIR=./data
DALDEGAN_SHOW_FULL_HASH=true
